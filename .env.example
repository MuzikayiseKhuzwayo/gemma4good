# Gemma 4 Agentic Operating System (AOS) Environment Configuration
# Optional: Set your Gemini / Google GenAI API key for Gemma Deep Kernel cloud reasoning.
# If omitted, AOS defaults cleanly to offline deterministic edge reasoning.
GEMINI_API_KEY=your_gemini_api_key_here

# Hardware & Quantization Options: "auto", "cpu", "cuda", "vulkan", "npu"
AOS_HARDWARE_TARGET=auto
AOS_QUANT_BITS=4
